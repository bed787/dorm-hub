{
  "uid": "dorm-hub-http",
  "title": "Dorm Hub — API",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Europe/Moscow",
  "refresh": "30s",
  "tags": [
    "dorm-hub",
    "http"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Запросы за период",
      "description": "Оценка прироста счётчика за выбранный период; учитывает перезапуски приложения.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(sum by (route,method) (increase(dormhub_http_requests_total{job=\"dorm-hub\",instance=~\"${instance:regex}\",method=~\"${method:regex}\",route=~\"${scope:raw}\",route=~\"${route:regex}\"}[$__range])))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{endpoint}}",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "—"
                }
              }
            }
          ],
          "noValue": "—",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 2,
      "title": "Среднее время ответа",
